# Copia este archivo como .env.local para probar en tu computadora,
# o pega estas variables en Vercel → Project → Settings → Environment Variables.

# Proveedor de IA: "openai" o "fal"
IMAGE_PROVIDER=openai

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# fal.ai (https://fal.ai/dashboard/keys) — solo si IMAGE_PROVIDER=fal
FAL_KEY=

# Opcional: código que se pide en el estudio para que nadie más gaste tus créditos
STUDIO_PASSWORD=
