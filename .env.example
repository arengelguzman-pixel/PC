# Copia este archivo como .env.local para probar en tu computadora,
# o pega estas variables en Vercel → Project → Settings → Environment Variables.

# Credenciales de Higgsfield Cloud (https://cloud.higgsfield.ai) en formato API_KEY:API_SECRET
HF_KEY=

# Opcional: modelos de Higgsfield (ids tal como aparecen en el catálogo de la API)
HIGGSFIELD_EDIT_MODEL=alibaba/qwen-image-3/edit
HIGGSFIELD_T2I_MODEL=z-image/turbo
HIGGSFIELD_RESOLUTION=2k

# Opcional: código que se pide en el estudio para que nadie más gaste tus créditos
STUDIO_PASSWORD=
